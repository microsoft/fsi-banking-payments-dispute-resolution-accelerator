# Set to "true" to run against demo data without a live backend.
# In local dev (vite dev server) the app automatically falls back to demo data
# on API errors. In a production build you must set this explicitly.
VITE_USE_MOCK=true

# Override the API base URL for non-SWA deployments (optional).
# Default: relative path /api (works with SWA proxy and Vite dev proxy)
# VITE_API_BASE_URL=https://<your-functions-app>.azurewebsites.net/api
